{
  "name": "lnasm",
  "displayName": "lnasm",
  "description": "LNASM/LNC language support and LNCPU debugging for Visual Studio Code.",
  "version": "0.0.1",
  "publisher": "LorenzoNotaro",
  "engines": {
    "vscode": "^1.96.0"
  },
  "activationEvents": [
    "workspaceContains:**/*.lnasm",
    "workspaceContains:**/*.lnc",
    "onDebug:lncpu"
  ],
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "contributes": {
    "languages": [{
      "id": "lnasm",
      "aliases": ["LNASM", "lnasm"],
      "extensions": [".lnasm"],
      "configuration": "./lnasm-language-configuration.json"
    },
  
    {
      "id": "lnc",
      "aliases": ["LNC", "lnc"],
      "extensions": [".lnc", ".lnh"],
      "configuration": "./lnc-language-configuration.json"
    }],
    "grammars": [{
      "language": "lnasm",
      "scopeName": "source.lnasm",
      "path": "./syntaxes/lnasm.tmLanguage.json"
    },
    {
      "language": "lnc",
      "scopeName": "source.lnc",
      "path": "./syntaxes/lnc.tmLanguage.json"
    }],
    "configuration": {
      "type": "object",
      "title": "LNASM Basics",
      "properties": {
        "lnasmBasics.indexGlobs": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["**/*.lnasm", "**/*.s"],
          "description": "Globs to index for symbols (labels, sublabels, %define, .section)."
        },
        "lnasm.path": {
          "type": "array",
          "default": ["**/*.lnasm", "**/*.s"],
          "description": "Globs to index for symbols (labels, sublabels, %define, .section)."
        },
        "lnasmBasics.instrTsvPath": {
          "type": "string",
          "default": "docs/opcodes.tsv",
          "description": "Path to the instruction-set TSV, resolved relative to the EXTENSION ROOT (context.extensionUri)."
        }
      }
    },
    "breakpoints": [
      { "language": "lnasm" },
      { "language": "lnc" }
    ],
    "debuggers": [
      {
        "type": "lncpu",
        "label": "LNCPU Debug",
        "languages": ["lnasm", "lnc"],
        "configurationAttributes": {
          "launch": {
            "required": ["lncPath", "emulatorPath", "sourceFiles"],
            "properties": {
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}",
                "description": "Working directory used to resolve all relative paths."
              },
              "lncPath": {
                "type": "string",
                "description": "Path to the lnc executable or lnc JAR."
              },
              "javaPath": {
                "type": "string",
                "default": "java",
                "description": "Java executable used when lncPath points to a JAR."
              },
              "emulatorPath": {
                "type": "string",
                "description": "Path to the lncpu-emu executable."
              },
              "sourceFiles": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1,
                "description": "LNC and LNASM source files compiled before launch."
              },
              "compilerOptions": {
                "type": "array",
                "items": { "type": "string" },
                "default": [],
                "description": "Additional lnc arguments."
              },
              "emulatorOptions": {
                "type": "array",
                "items": { "type": "string" },
                "default": [],
                "description": "Additional lncpu-emu arguments."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true,
                "description": "Stop before executing the first instruction."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "lncpu",
            "request": "launch",
            "name": "Debug LNCPU program",
            "cwd": "${workspaceFolder}",
            "lncPath": "${workspaceFolder}/lnc.jar",
            "javaPath": "java",
            "emulatorPath": "${workspaceFolder}/lncpu-emu",
            "sourceFiles": ["${file}"],
            "compilerOptions": [],
            "emulatorOptions": []
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "lnasm.peekDefinition",
        "title": "lnasm: Peek Definition",
        "category": "lnasm"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "lnasm.peekDefinition",
          "when": "editorLangId == lnasm",
          "group": "navigation@1"
        }
      ]
    }

  },
  "main": "./out/main.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  
  "devDependencies": {
    "typescript": "^5.4.0",
    "vscode-languageclient": "^7.0.0",
    "@types/vscode": "^1.96.0",
    "@types/node": "^18.0.0",
    "vsce": "^2.10.0"
  }
}
