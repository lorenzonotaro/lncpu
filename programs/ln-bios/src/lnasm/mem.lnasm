%ifndef MEMUTILS_F
%define MEMUTILS_F

.section MEMUTILS
; lnc compliant
;
; ```memzero(RA = length, RC:RD = dest)```
;
; zeroes a block of memory starting at RC:RD, length of RA.
;
; Returns nothing.
;
; lnc signature: ```void memzero(void far *dest, unsigned int length);```
memzero:
    push        RA      ; save RA, RB, RC, RD
    push        RB
    push        RC
    push        RD
    xor         RB,     RB ; clear RB (used as zero value)
_while:
    cmp         RA,    0; while RA > 0
    jz          _end_while
    mov         RB,    [RC:RD]
    dec         RA
    inc         RD
    jc          _carryrc
    goto        _while
_carryrc:
    inc         RC
    goto        _while
_end_while:
    pop         RD      ; restore RD, RC, RB, RA
    pop         RC
    pop         RB
    pop         RA
    ret

.export memzero

; lnc compliant
;
; fills a block of memory starting at RC:RD, length of RA, with the value in RB.
; ``` memfill(RA = length, RB = value, RC:RD = dest)```
;
; Returns nothing.
;
; lnc signature: ```void memfill(void far *dest, unsigned int length, unsigned int value);```
memfill:
    push        RA      ; save RA, RB, RC, RD
    push        RC
    push        RD
_while:
    cmp         RA,    0; while RA > 0
    jz          _end_while
    mov         RB,    [RC:RD]
    dec         RA
    inc         RD
    jc          _carryrc
    goto        _while
_carryrc:
    inc         RC
    goto        _while
_end_while:
    pop         RD      ; restore RD, RC, RB, RA
    pop         RC
    pop         RA
    ret
.export memfill

; lnc compliant
;
; ```memcpy(RA = length, RC:RD = src, dest long pointer passed on stack)```
;
; Copies `length` bytes from `src` to `dest`.
;
; The `dest` pointer is passed on the stack by the caller (2 bytes).
; Returns nothing.
; 
; lnc signature: ```void memcpy(void far *src, void far *dest, unsigned int length);```
memcpy:
    push        RA
    push        RB
    push        RC
    push        RD
    push        BP
    mov         SP, BP
    add         SP, 0x04        ; locals: [BP+0]=dst_lo, [BP+1]=dst_hi, [BP+2]=src_lo, [BP+3]=src_hi

    ; Save the source pointer and fetch the destination pointer from the caller's stack frame.
    mov         RD, [BP + 2]
    mov         RC, [BP + 3]
    mov         [BP - 8], RB
    mov         RB, [BP + 0]
    mov         [BP - 9], RB
    mov         RB, [BP + 1]

_byte_loop:
    cmp         RA, 0
    jz          _byte_done

    ; Load one byte from src into RB.
    mov         [BP + 2], RD
    mov         [BP + 3], RC
    mov         [RC:RD], RB

    ; src++
    inc         RD
    jc          _src_hi_carry
    goto        _src_ok
_src_hi_carry:
    inc         RC
_src_ok:
    mov         RD, [BP + 2]
    mov         RC, [BP + 3]

    ; Store the byte into dest.
    mov         [BP + 0], RD
    mov         [BP + 1], RC
    mov         RB, [RC:RD]

    ; dst++
    inc         RD
    jc          _dst_hi_carry
    goto        _dst_ok
_dst_hi_carry:
    inc         RC
_dst_ok:
    mov         RD, [BP + 0]
    mov         RC, [BP + 1]

    dec         RA
    goto        _byte_loop

_byte_done:
    sub         SP, 0x04
    pop         BP
    pop         RD
    pop         RC
    pop         RB
    pop         RA
    ret         0x02

.export memcpy

; lnc compliant
;
; ```lmemcpy(RA = length low, stack = length high, RC:RD = src, dest long pointer passed on stack)```
;
; Copies `length` bytes from `src` to `dest`, allowing the copy to span multiple 256-byte pages.
;
; The `dest` pointer is passed on the stack by the caller (2 bytes), followed by the high byte of `length`.
; Returns nothing.
;
; lnc signature: ```void lmemcpy(void far *src, void far *dest, unsigned long int length);```
.section MEMUTILS_LONG
lmemcpy:
    push        RA
    push        RB
    push        RC
    push        RD
    push        BP
    mov         SP, BP
    add         SP, 0x05        ; locals: [BP+0]=dst_lo, [BP+1]=dst_hi, [BP+2]=src_lo, [BP+3]=src_hi, [BP+4]=len_hi

    ; Save the source pointer and fetch the destination pointer from the caller's stack frame.
    mov         RD, [BP + 2]
    mov         RC, [BP + 3]
    mov         [BP - 8], RB
    mov         RB, [BP + 0]
    mov         [BP - 9], RB
    mov         RB, [BP + 1]

    ; Load the 16-bit length.
    mov         [BP - 10], RA
    mov         [BP - 11], RB
    mov         RB, [BP + 4]

_lbyte_loop:
    cmp         RA, 0
    jz          _lcheck_high
    goto        _ldecrement

_lcheck_high:
    mov         [BP + 4], RB
    cmp         RB, 0
    jz          _ldone

_ldecrement:
    dec         RA
    jc          _llen_borrow
    goto        _lcopy

_llen_borrow:
    mov         [BP + 4], RB
    dec         RB
    mov         RB, [BP + 4]

_lcopy:
    ; Load one byte from src into RB.
    mov         [BP + 2], RD
    mov         [BP + 3], RC
    mov         [RC:RD], RB

    ; src++
    inc         RD
    jc          _lsrc_hi_carry
    goto        _lsrc_ok
_lsrc_hi_carry:
    inc         RC
_lsrc_ok:
    mov         RD, [BP + 2]
    mov         RC, [BP + 3]

    ; Store the byte into dest.
    mov         [BP + 0], RD
    mov         [BP + 1], RC
    mov         RB, [RC:RD]

    ; dst++
    inc         RD
    jc          _ldst_hi_carry
    goto        _ldst_ok
_ldst_hi_carry:
    inc         RC
_ldst_ok:
    mov         RD, [BP + 0]
    mov         RC, [BP + 1]

    goto        _lbyte_loop

_ldone:
    sub         SP, 0x05
    pop         BP
    pop         RD
    pop         RC
    pop         RB
    pop         RA
    ret         0x04

.export lmemcpy

; lnc non-compliant
;
; ```memcmp(RA = length, RC:RD = buf1, buf2 long pointer passed on stack)```
;
; Returns 0 in RB when the buffers are equal, 1 otherwise.
memcmp:
    push        RA
    push        RC
    push        RD
    push        BP
    mov         SP, BP
    add         SP, 0x05        ; locals: [BP+0]=buf1_lo, [BP+1]=buf1_hi, [BP+2]=buf2_lo, [BP+3]=buf2_hi, [BP+4]=count

    ; Save the current pointers and byte count.
    mov         RD, [BP + 0]
    mov         RC, [BP + 1]
    mov         [BP - 8], RB
    mov         RB, [BP + 2]
    mov         [BP - 7], RB
    mov         RB, [BP + 3]
    mov         RA, [BP + 4]

_cmp_loop:
    mov         [BP + 4], RA
    cmp         RA, 0
    jz          _cmp_equal

    dec         RA
    mov         RA, [BP + 4]

    ; Load one byte from buf1 into RB.
    mov         [BP + 0], RD
    mov         [BP + 1], RC
    mov         [RC:RD], RB

    ; buf1++
    inc         RD
    jc          _cmp_src1_hi_carry
    goto        _cmp_src1_ok
_cmp_src1_hi_carry:
    inc         RC
_cmp_src1_ok:
    mov         RD, [BP + 0]
    mov         RC, [BP + 1]

    ; Load one byte from buf2 into RA.
    mov         [BP + 2], RD
    mov         [BP + 3], RC
    mov         [RC:RD], RA

    xor         RB, RA
    jz          _cmp_bytes_equal

    mov         1, RB
    goto        _cmp_done

_cmp_bytes_equal:
    ; buf2++
    inc         RD
    jc          _cmp_src2_hi_carry
    goto        _cmp_src2_ok
_cmp_src2_hi_carry:
    inc         RC
_cmp_src2_ok:
    mov         RD, [BP + 2]
    mov         RC, [BP + 3]

    mov         RA, [BP + 4]
    goto        _cmp_loop

_cmp_equal:
    xor         RB, RB

_cmp_done:
    sub         SP, 0x05        ; free locals
    pop         BP
    pop         RD
    pop         RC
    pop         RA
    ret         0x02            ; discard 2-byte stack arg (buf2)

.export memcmp

%endif