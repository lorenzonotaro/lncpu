#include "ddi.lnh"
#include "boot.lnh"
#include "mem.lnh"
#include "mem.lnh"
#include "lnfs.lnh"

void find_boot_devices() {

    memfill(&boot_devices_table, sizeof(boot_devices_table), 0xFF);

    unsigned int count = 0;
    for(unsigned int i = 2; i < ddi_num_devices; i++) {
        unsigned int dev_flags = ddi_get_device(i)->descriptor->flags;
        if(dev_flags & DEV_FLAG_BOOTABLE){
            if(count < 8){
                boot_devices_table[count].device_idx = i;
                if(dev_flags & DEV_FLAG_LNFS){
                    boot_devices_table[count].boot_mode = 1; // LNFS boot mode
                } else {
                    boot_devices_table[count].boot_mode = 0; // XIP mode
                }
                count++;
            }
        }
    }
    boot_devices_count = count;
}

int lnfs_boot(struct ddi_device far *dev){
    lnfs_error_code = 0; // Reset error code before starting boot process
    int start_page = dev->start_page;
    struct lnfs_superblock far *sb = (struct lnfs_superblock far *) (dev->start_page << 8) + 0;
    if(memcmp(sb, SUPERBLOCK_SIGNATURE, 4) != 0){
        lnfs_error_code = LNFS_ERROR_INVALID_SUPERBLOCK;
        return BIOS_STATUS_CRIT_LNFS_MALFORMED_LNFS;
    }
    struct lnfs_inode far *knode = lnfs_get_kernel_inode(sb, start_page);
    if(knode == 0){
        // lnfs_error_code is already set by lnfs_get_kernel_inode
        return BIOS_STATUS_CRIT_LNFS_MALFORMED_LNFS;
    }
    unsigned int result = lnxe_load(knode, LNFS_KERNEL_LOAD_ADDRESS);

    if(result != 0){
        return BIOS_STATUS_CRIT_LNFS_KERNEL_LOAD_FAILURE;
    }

    // TODO: goto kernel entry point

    return 0;
}