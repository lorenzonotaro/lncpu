#include "lnfs.lnh"
#include "ddi.lnh"
#include "mem.lnh"

void far *add_device_offset(void far *ptr, unsigned int start_page){
    void far *start_addr = ((void far *)(start_page << 8)) + 0;
    return ptr + start_addr;
}

struct lnfs_inode far *lnfs_find_file(struct lnfs_inode far *dir, unsigned int start_page){
    if((dir->flags & LNFS_INODE_FLAG_DIR) == 0){
        lnfs_error_code = LNFS_ERROR_NOT_A_DIRECTORY;
        return (struct lnfs_inode far *) 0; // Not a directory
    }
    unsigned int far *data = ((unsigned int far *)(add_device_offset(dir->block, start_page) + sizeof(struct lnfs_block)));
    unsigned int count = *data; //number of entries in the directory
    data++;
    for(unsigned int i = 0; i < count; i++){
        struct lnfs_inode far *node = get_inode_by_index(*data, start_page);
        if(node != 0 && memcmp(&node->name, "KERNEL", 6) == 0){
            return node; // File found
        }
        data++;
    }
    lnfs_error_code = LNFS_ERROR_FILE_NOT_FOUND;
    return (struct lnfs_inode far *) 0; // File not found
}

struct lnfs_inode far *get_inode_by_index(unsigned int index, unsigned int start_page){
    struct lnfs_superblock far *sb = ((struct lnfs_superblock far *) (start_page << 8)) + 0;
    if(index >= sb->max_inodes){
        lnfs_error_code = LNFS_ERROR_FILE_NOT_FOUND;
        return (struct lnfs_inode far *) 0; // Index out of bounds
    }
    struct lnfs_inode far *inode_array = (struct lnfs_inode far *)(sb + sizeof(struct lnfs_superblock));
    return &inode_array[index];
}

struct lnfs_inode far *lnfs_get_kernel_inode(struct lnfs_superblock far *sb, unsigned int start_page){
    struct lnfs_inode far *root = sb + sizeof(struct lnfs_superblock); // Root inode is located immediately after the superblock
    if(memcmp(root, "ROOT\0", 5) != 0){
        lnfs_error_code = LNFS_ERROR_FIRST_INODE_NOT_ROOT;
        return (struct lnfs_inode far *) 0;
    }
    struct lnfs_inode far *kernel_node = lnfs_find_file(root, start_page);
    return kernel_node;
}

unsigned int lnxe_load(struct lnfs_block far *block, void far *load_address){
    if(block->flags & ~LNFS_BLOCK_FLAG_USED){
        lnfs_error_code = LNFS_ERROR_INVALID_KERNEL_FILE;
        return 1; // Block is marked as free, invalid kernel file
    }

    struct lnxe_header far *data = block + sizeof(struct lnfs_block); // Data is located immediately after the block header

    if(memcmp(data, "LNXE", 4) != 0){
        lnfs_error_code = LNFS_ERROR_INVALID_KERNEL_FILE;
        return 1; // Invalid LNXE header
    }

    lmemcpy(data + sizeof(struct lnxe_header), load_address, block->size - sizeof(struct lnxe_header)); // Copy the actual code/data to the load address

    return 0; // Success
}