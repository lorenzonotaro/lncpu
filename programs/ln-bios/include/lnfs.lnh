#ifndef LNFS_LNH
#define LNFS_LNH

#define LNFS_ERROR_INVALID_SUPERBLOCK 0x01

#define LNFS_ERROR_FIRST_INODE_NOT_ROOT 0x02

#define LNFS_ERROR_NOT_A_DIRECTORY 0x03

#define LNFS_ERROR_FILE_NOT_FOUND 0x04

#define LNFS_ERROR_INVALID_KERNEL_FILE 0x05

#define SUPERBLOCK_SIGNATURE "LNFS"

#define SUPERBLOCK_FLAG_READONLY 0x01

struct lnfs_superblock {
    char signature[4]; // "LNFS"
    unsigned int version;
    unsigned int size_pages;
    unsigned int _reserved;
    unsigned int max_inodes;
    unsigned int _reserved2;
    unsigned int first_free_inode;
    unsigned int flags;
    unsigned int _magic;
};

#define LNFS_INODE_FLAG_USED 0x01
#define LNFS_INODE_FLAG_DIR 0x02
#define LNFS_INODE_FLAG_READONLY 0x04
#define LNFS_INODE_FLAG_HIDDEN 0x08
#define LNFS_INODE_FLAG_ROOT 0x10
#define LNFS_INODE_FLAG_EXECUTABLE 0x20

struct lnfs_inode {
    char name[8];
    unsigned int parent_inode;
    unsigned int flags;
    struct lnfs_block far *block;
};

#define LNFS_BLOCK_FLAG_USED 0x01
#define LNFS_BLOCK_FLAG_IMMOVABLE 0x02

struct lnfs_block {
    struct lnfs_block far *prev;
    struct lnfs_block far *next;
    unsigned int flags;
    unsigned int inode_index;
    unsigned long int size;
};

struct lnxe_header {
    char signature[4]; // "LNXE"
    unsigned int version;
    unsigned long int entry_point; // entry point offset from code_offset
    unsigned long int code_size;   // size of code section, in bytes
    unsigned long int code_offset; // offset of code section from start of file
    unsigned long int data_size;   // size of requested data section, in bytes
    unsigned long int const_size;  // size of const table section, in bytes
    unsigned long int reloc_table_size; // size of relocation table, in entries (unsigned long int, 2 bytes each)
    unsigned int reserved[5];         // reserved to pad the header to 24 bytes
    // follows a relocation table of unsigned int entries, then the actual code/data
};

#define LNXE_SIGNATURE "LNXE"
#define LNXE_VERSION 0x01

// Relocation modes are stored in the upper 3 bits of the relocation entry
#define LNXE_RELOC_MODE_MASK      0b11100000

// No relocation, just load the value as is
#define LNXE_RELOC_MODE_NONE      0b00000000

// Relocate the value to the load address of the code section
#define LNXE_RELOC_MODE_LOAD_ADDR 0b00100000

// Relocate the value to its actual address in the device
#define LNXE_RELOC_MODE_DEVICE    0b01000000

// Relocate the value to point to the allocated data section in memory
#define LNXE_RELOC_MODE_DATA      0b01100000

extern unsigned int lnfs_error_code;

struct lnfs_block far *lnfs_get_kernel_inode(struct lnfs_superblock far *sb, unsigned int start_page);

struct lnfs_inode far *lnfs_find_file(struct lnfs_inode far *dir, unsigned int start_page);

struct lnfs_inode far *get_inode_by_index(unsigned int index, unsigned int start_page);

void far *add_device_offset(void far *ptr, unsigned int start_page);

unsigned int lnxe_load(struct lnfs_block far *kblock, void far *load_address);

#endif