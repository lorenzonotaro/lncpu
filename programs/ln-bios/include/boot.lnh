#ifndef BOOT_LNH
#define BOOT_LNH

#define BIOS_STATUS_CRIT_LNFS_MALFORMED_LNFS 0x12

#define BIOS_STATUS_CRIT_LNFS_KERNEL_LOAD_FAILURE 0x13

#define LNFS_KERNEL_LOAD_ADDRESS 0x2400

struct boot_device {
    unsigned int device_idx;
    unsigned int boot_mode;
};

extern far unsigned int boot_devices_count;
extern far struct boot_device boot_devices_table[8];

extern void find_boot_devices();

extern int lnfs_boot(struct ddi_device far *dev);

extern void os_transfer(void far *address);

#endif